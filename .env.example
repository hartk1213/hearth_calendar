# Copy this file to ".env" and fill it in. The .env file is never uploaded to GitHub.
# Everything else (family, calendars, chores, weather...) is set up inside the app.

# Your time zone, so calendar times are right. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Los_Angeles

# The port to open Hearth on: http://<this-computer>:8095
HOST_PORT=8095

# --- Database (optional) ---
# Leave DB_HOST empty to store everything in the ./data folder instead.
# To use MariaDB/MySQL, put the database server's IP address here.
DB_HOST=
DB_PORT=3306
DB_NAME=hearth
DB_USER=hearth
# Make up a password; Hearth creates its database user with it.
DB_PASSWORD=
# First start only: your MariaDB root password, so Hearth can create its
# database and user. Remove it once the logs say "created database".
DB_ROOT_PASSWORD=

# --- Unraid only ---
# Run as nobody:users so appdata permissions stay normal. Elsewhere, leave these out.
# PUID=99
# PGID=100
